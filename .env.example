# KasWarga — contoh variabel lingkungan
# Salin menjadi .env lalu isi dengan nilai proyek Anda sendiri.
# Jangan pernah meng-commit file .env yang sudah terisi.

# Supabase — ambil dari Project Settings > API di dashboard Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opsional — pemantauan error. Kosongkan bila tidak dipakai.
VITE_SENTRY_DSN=

# Opsional — isi "demo" hanya pada deployment lingkungan demo.
# Nilai ini menampilkan banner demo dan menyembunyikan tautan ke situs demo.
VITE_APP_MODE=

# Opsional — alamat situs demo yang ditautkan dari halaman login.
VITE_DEMO_URL=https://kaswarga-demo.netlify.app
